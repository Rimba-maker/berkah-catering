---
import { credits } from '../config/photos';

const links = [
  { label: 'Layanan', href: '#layanan' },
  { label: 'Paket Aqiqah', href: '#paket-aqiqah' },
  { label: 'Paket Syukuran', href: '#paket-syukuran' },
  { label: 'Menu', href: '#menu' },
  { label: 'Proses Pemesanan', href: '#proses' },
  { label: 'FAQ', href: '#faq' },
];

// satu tautan per fotografer
const byPhotographer = [...new Map(credits.map((c) => [c.by, c.url])).entries()];
---

<footer class="foot">
  <div class="container">
    <p class="foot__mast" aria-hidden="true">
      Berkah Catering
    </p>
    <div class="foot__grid">
      <div>
        <h2>Berkah Catering</h2>
        <p>Hidangan Penuh Berkah, Untuk Momen Yang Tak Terlupakan.</p>
        <p style="margin-top: var(--space-md);">Halal MUI dan 500+ aqiqah sukses.</p>
      </div>
      <nav aria-label="Navigasi footer">
        <h2>Navigasi</h2>
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <h2>Hubungi Kami</h2>
        <address>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener">
            WhatsApp
          </a>
          <span>Padang, Sumatera Barat</span>
          <span>Setiap hari, 08.00 sampai 20.00</span>
        </address>
        <p style="margin-top: var(--space-lg);">
          <a href="#konsultasi" class="btn">
            Konsultasi Gratis
          </a>
        </p>
      </div>
    </div>
    <p class="foot__credits" data-credits>
      Semua foto adalah ilustrasi dari Pexels, bukan dokumentasi Berkah Catering. Fotografer:
      {byPhotographer.map(([by, url], i) => (
        <>
          {i > 0 ? ', ' : ' '}
          <a href={url} target="_blank" rel="noopener">
            {by}
          </a>
        </>
      ))}
      .
    </p>
    <div class="foot__legal">
      <span>© 2025 Berkah Catering.</span>
      <span>Halal, Amanah, Terpercaya</span>
    </div>
  </div>
</footer>
