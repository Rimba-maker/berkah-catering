---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'Layanan', href: '#layanan' },
  { label: 'Paket Aqiqah', href: '#paket-aqiqah' },
  { label: 'Paket Syukuran', href: '#paket-syukuran' },
  { label: 'Menu', href: '#menu' },
];
---

<header id="navbar" class="nav">
  <div class="container nav__in">
    <a href={`${base}/`} id="nav-logo" class="brand">
      Berkah Catering
    </a>
    <nav id="nav-links" class="nav__links" aria-label="Navigasi utama">
      {links.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
      <a href="#konsultasi" id="nav-cta" class="btn">
        Hubungi
      </a>
    </nav>
    <button
      type="button"
      id="hamburger"
      class="nav__toggle"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </div>
  <nav id="mobile-menu" class="nav__menu" aria-label="Navigasi seluler">
    {links.map(({ label, href }) => (
      <a href={href}>{label}</a>
    ))}
    <a href="#konsultasi" class="btn">
      Hubungi
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('hamburger')!;
  const menu = document.getElementById('mobile-menu')!;
  const set = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    toggle.textContent = open ? 'Tutup' : 'Menu';
  };
  toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>
